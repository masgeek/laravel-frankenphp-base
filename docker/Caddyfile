{
	admin off
	auto_https off
	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
		}
	}

	log {
		level {$CADDY_LOG_LEVEL:INFO}
	}
}

:80 {

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode zstd br gzip

		header {
			X-Frame-Options "SAMEORIGIN"
			X-Content-Type-Options "nosniff"
			-Server
		}

		php_server
	}
}
